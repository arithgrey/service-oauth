DEBUG=True
LOCAL=True
SECRET_KEY=django-insdecure-r9%h!nx9_(_hmc3aoe$-)i0sqp483py$q4eotc7&e&1$tu*qbh
STRIPE_SECRET_KEY=''
# Llave con la que oauth FIRMA los JWT. Cada servicio que valide tokens de oauth
# (p.ej. enid-store) debe usar el mismo valor en su propio JWT_SIGNING_KEY.
JWT_SIGNING_KEY=shared-jwt-signing-key-must-match-service-oauth
# Necesaria en True para que el post_migrate siembre stores, grupos, permisos
# y el usuario admin (ver store/signals.py: run_seed).
DJANGO_RUNNING_MIGRATIONS=True
# Admin sembrado de raíz. El password se guarda como SHA-256 del texto plano
# porque el frontend envía el password ya hasheado. Default: igual al email.
ADMIN_SEED_EMAIL=enidservice@gmail.com
ADMIN_SEED_PASSWORD=enidservice@gmail.com
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
DATABASE_URL=
DOMAIN=http://127.0.0.1:8000
